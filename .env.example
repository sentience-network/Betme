# Copy to .env and adjust for your environment.

# Prisma database connection.
# Local dev uses SQLite. On Render (with a persistent disk) use a path on the
# mounted disk, e.g. file:/var/data/prod.db
DATABASE_URL="file:./dev.db"

# Google AdSense publisher/client id, e.g. "ca-pub-1234567890123456".
# Leave unset to show house placeholder ad slots (no real ads/revenue).
# This is a NEXT_PUBLIC_ variable so it is exposed to the browser (that is
# expected for AdSense).
# NEXT_PUBLIC_ADSENSE_CLIENT="ca-pub-XXXXXXXXXXXXXXXX"
