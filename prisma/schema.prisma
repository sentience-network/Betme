// Betme — social predictive market data model.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  displayName  String
  bio          String   @default("")
  avatarColor  String   @default("#6366f1")
  balance      Int      @default(1000) // play-money credits used to stake predictions
  createdAt    DateTime @default(now())

  predictions      Prediction[]  @relation("PredictionCreator")
  stakes           Stake[]
  chatMessages     ChatMessage[]
  sentMessages     DirectMessage[] @relation("MessageSender")
  receivedMessages DirectMessage[] @relation("MessageRecipient")
  following        Follow[]        @relation("Follower")
  followers        Follow[]        @relation("Following")
  badges           UserBadge[]
}

model Prediction {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  category    String    @default("General")
  status      String    @default("OPEN") // OPEN | RESOLVED
  outcome     String? // YES | NO (set when resolved)
  closesAt    DateTime?
  createdAt   DateTime  @default(now())

  creatorId String
  creator   User   @relation("PredictionCreator", fields: [creatorId], references: [id])

  stakes       Stake[]
  chatMessages ChatMessage[]
}

model Stake {
  id           String   @id @default(cuid())
  side         String // YES | NO
  amount       Int
  payout       Int? // credits paid out when the prediction resolved
  createdAt    DateTime @default(now())

  predictionId String
  prediction   Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id])

  @@index([predictionId])
  @@index([userId])
}

model ChatMessage {
  id           String   @id @default(cuid())
  body         String
  createdAt    DateTime @default(now())

  predictionId String
  prediction   Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  authorId     String
  author       User       @relation(fields: [authorId], references: [id])

  @@index([predictionId])
}

model DirectMessage {
  id          String   @id @default(cuid())
  body        String   @default("")
  videoUrl    String? // path to an uploaded video message, when present
  createdAt   DateTime @default(now())

  senderId    String
  sender      User     @relation("MessageSender", fields: [senderId], references: [id])
  recipientId String
  recipient   User     @relation("MessageRecipient", fields: [recipientId], references: [id])

  @@index([senderId])
  @@index([recipientId])
}

model Follow {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())

  followerId  String
  follower    User     @relation("Follower", fields: [followerId], references: [id])
  followingId String
  following   User     @relation("Following", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
  @@index([followingId])
}

model UserBadge {
  id        String   @id @default(cuid())
  slug      String // e.g. first_prediction, sharpshooter, popular
  earnedAt  DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, slug])
  @@index([userId])
}
